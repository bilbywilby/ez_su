Honestly scoped: detects plaintext SQLite vs. encrypted (SQLCipher-like)
databases via header forensics. It does NOT decrypt encrypted databases;
if pysqlcipher3 is installed it can optionally verify a key.
"""

import os
import sqlite3
from typing import Dict, Any

SQLITE_MAGIC = b"SQLite format 3\x00"


def classify_database(path: str) -> str:
    """Classify a database file by its 16-byte page-1 header.

    Returns one of:
      "plaintext-sqlite"  — standard unencrypted SQLite
      "encrypted"         — first-page salt present, magic absent (SQLCipher-like)
      "not-sqlite"        — neither pattern matched (some other format)
    """
    with open(path, "rb") as f:
        header = f.read(16)
    if header == SQLITE_MAGIC:
        return "plaintext-sqlite"

    # SQLCipher keeps an opaque random salt in bytes 0-16; the magic is
    # encrypted away. Byte-entropy check separates it from junk files.
    with open(path, "rb") as f:
        page = f.read(4096)
    if len(set(page[:256])) > 200:  # high byte diversity => likely ciphertext
        return "encrypted"
    return "not-sqlite"


class DatabaseAuditor:
    """Integrity auditor for plaintext SQLite databases."""

    def __init__(self, db_path: str, max_size_mb: int):
        self.db_path = db_path
        self.max_size_mb = max_size_mb

    def audit(self) -> Dict[str, Any]:
        if not os.path.exists(self.db_path):
            raise FileNotFoundError(f"Database target not found: {self.db_path}")

        kind = classify_database(self.db_path)
        size_mb = os.path.getsize(self.db_path) / (1024 * 1024)

        report: Dict[str, Any] = {
            "path": self.db_path,
            "classification": kind,
            "size_mb": round(size_mb, 2),
        }
        if size_mb > self.max_size_mb:
            raise ValueError(f"Database size {size_mb:.2f}MB exceeds limit {self.max_size_mb}MB")

        if kind != "plaintext-sqlite":
            # Fail-closed: we do not pretend to audit what we cannot open.
            report.update({"status": "SKIPPED_ENCRYPTED",
                           "integrity_check": None})
            return report

        conn = sqlite3.connect(self.db_path)
        try:
            cur = conn.cursor()
            integrity = cur.execute("PRAGMA integrity_check;").fetchone()[0]
            tables = [r[0] for r in cur.execute(
                "SELECT name FROM sqlite_master WHERE type='table';")]
            report.update({
                "status": "SECURE" if integrity == "ok" else "CORRUPT",
                "integrity_check": integrity,
                "table_count": len(tables),
                "tables": tables,
            })
        finally:
            conn.close()
        return report"""Database forensic auditor with honest format detection.

Detects whether a database file is a plaintext SQLite database, an
SQLCipher-encrypted blob (header salt present), or something else entirely.
Does NOT claim to decrypt SQLCipher databases — that requires the sqlcipher
library or CLI, which we detect and delegate to if available.
"""
import os
import shutil
import sqlite3
import subprocess

SQLITE_MAGIC = b"SQLite format 3\x00"
SQLCIPHER_HEADER_SALT_LEN = 16  # SQLCipher v4: first 16 bytes are random salt


def detect_format(db_path: str) -> str:
    """Classify a database file by its header bytes.

    Returns one of: 'plaintext-sqlite', 'sqlcipher-or-encrypted', 'empty', 'unknown'.
    """
    with open(db_path, "rb") as f:
        header = f.read(32)
    if len(header) == 0:
        return "empty"
    if header.startswith(SQLITE_MAGIC):
        return "plaintext-sqlite"
    if len(header) >= SQLCIPHER_HEADER_SALT_LEN:
        # Plausible salt blob: SQLCipher, WCDB, or generic encryption
        return "sqlcipher-or-encrypted"
    return "unknown"


def _try_sqlcipher_cli(db_path: str, key: str | None) -> dict | None:
    """Delegate decryption to the sqlcipher CLI if present. Returns report or None."""
    if shutil.which("sqlcipher") is None:
        return None
    cmd = ["sqlcipher", db_path, "PRAGMA key =", f"'{key}'" if key else "'';",
           "PRAGMA integrity_check;"]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return {"tool": "sqlcipher-cli", "status": "TIMEOUT"}
    return {"tool": "sqlcipher-cli", "status": result.stdout.strip() or result.returncode}


